msgctxt "decimal separator"
msgid "."
msgstr ","

#: src/logik.rs:344
msgid ""
"You are not allowed to install or remove software. The request was denied."
msgstr ""
"Sie sind nicht berechtigt, Software zu installieren oder zu entfernen. Die Anfrage wurde abgelehnt."

#: src/logik.rs:347
msgid "The session’s authorization dialog (polkit agent) is missing."
msgstr "Es fehlt der Berechtigungsdialog der Sitzung (polkit-Agent)."

#: src/logik.rs:349
#, no-c-format
msgid "The package manager is busy right now ({program})."
msgstr "Die Paketverwaltung ist gerade belegt ({program})."

#: src/logik.rs:353
msgid "No network connection."
msgstr "Keine Netzwerkverbindung."

#: src/logik.rs:355
#, no-c-format
msgid "The package “{package}” was not found."
msgstr "Das Paket „{package}“ wurde nicht gefunden."

#: src/logik.rs:358
#, no-c-format
msgid "Conflicting dependencies: {details}"
msgstr "Abhängigkeiten im Konflikt: {details}"

#: src/logik.rs:361
msgid "The package manager (PackageKit) was stopped during the operation."
msgstr "Die Paketverwaltung (PackageKit) wurde während des Vorgangs beendet."

#: src/logik.rs:363
msgid "The operation was cancelled."
msgstr "Der Vorgang wurde abgebrochen."

#: src/netz.rs:336
msgid "online (PackageKit)"
msgstr "online (PackageKit)"

#: src/netz.rs:337
msgid "online (network available)"
msgstr "online (Netzwerk verfügbar)"

#: src/netz.rs:338
msgid "online (archive reachable)"
msgstr "online (Archiv erreichbar)"

#: src/netz.rs:340
#, no-c-format
msgid "offline: {host} not reachable ({reason})"
msgstr "offline: {host} nicht erreichbar ({reason})"

#: src/netz.rs:344
msgid "offline: no network and no APT source to check"
msgstr "offline: kein Netzwerk und keine APT-Quelle zum Prüfen"

#: src/netz.rs:355
msgid ""
"PackageKit considers the system offline and may refuse to download packages."
msgstr ""
"PackageKit hält das System für offline und lehnt Downloads womöglich ab."

#: src/netz.rs:364
#, no-c-format
msgid "PackageKit: {state}"
msgstr "PackageKit: {state}"

#: src/netz.rs:369
msgid "online"
msgstr "online"

#: src/netz.rs:370
msgid "offline"
msgstr "offline"

#: src/netz.rs:371
msgid "no answer"
msgstr "keine Antwort"

#: src/netz.rs:376
#, no-c-format
msgid "Network monitor (GLib): {state}"
msgstr "Netzwerkmonitor (GLib): {state}"

#: src/netz.rs:381
msgid "network available"
msgstr "Netzwerk verfügbar"

#: src/netz.rs:383
msgid "no network"
msgstr "kein Netzwerk"

#: src/netz.rs:389
#, no-c-format
msgid "Software source {uri}: reachable ({answer})"
msgstr "Paketquelle {uri}: erreichbar ({answer})"

#: src/netz.rs:393
#, no-c-format
msgid "Software source {uri}: not reachable ({reason})"
msgstr "Paketquelle {uri}: nicht erreichbar ({reason})"

#: src/netz.rs:397
msgid "Software source: none found in /etc/apt"
msgstr "Paketquelle: keine in /etc/apt gefunden"

#: src/netz.rs:434
#, no-c-format
msgid "Querencia Software could not reach the software source {uri}."
msgstr "Querencia Software konnte die Paketquelle {uri} nicht erreichen."

#: src/netz.rs:438
msgid "Querencia Software found no software source in /etc/apt to check."
msgstr ""
"Querencia Software hat in /etc/apt keine Paketquelle zum Prüfen gefunden."

#: src/netz.rs:445
msgid ""
"Check the network connection. While offline, Querencia Software checks again every 30 seconds; “Check Again” in the status bar checks at once."
msgstr ""
"Prüfen Sie die Netzwerkverbindung. Solange keine Verbindung besteht, prüft Querencia Software alle 30 Sekunden erneut; „Erneut prüfen“ in der Statuszeile prüft sofort."

#: src/netz.rs:461
msgid "PackageKit Reports No Network"
msgstr "PackageKit meldet kein Netzwerk"

#: src/netz.rs:464
#, no-c-format
msgid ""
"The software source {uri} is reachable, but PackageKit considers the system offline and refuses to download packages. This happens when NetworkManager is installed but does not manage the network connection, for example on a server set up with netplan and systemd-networkd."
msgstr ""
"Die Paketquelle {uri} ist erreichbar, aber PackageKit hält das System für offline und lehnt Downloads ab. Das passiert, wenn NetworkManager installiert ist, die Netzwerkverbindung aber nicht verwaltet, zum Beispiel auf einem Server, der mit netplan und systemd-networkd eingerichtet ist."

#: src/netz.rs:472
msgid ""
"Let NetworkManager manage the connection (netplan: “renderer: NetworkManager”), or ask your system administrator. PackageKit notices the change by itself; then try again."
msgstr ""
"Lassen Sie NetworkManager die Verbindung verwalten (netplan: „renderer: NetworkManager“) oder wenden Sie sich an Ihre Systemverwaltung. PackageKit bemerkt die Änderung selbst; versuchen Sie es danach erneut."

#: src/netz.rs:516
msgid "no APT source found"
msgstr "keine APT-Quelle gefunden"

#: src/netz.rs:568 src/netz.rs:692
#, no-c-format
msgid "no answer within {seconds} s"
msgstr "keine Antwort in {seconds} s"

#: src/netz.rs:589
msgid "TCP connection, TLS not checked"
msgstr "TCP-Verbindung, TLS nicht geprüft"

#: src/netz.rs:609
msgid "no HTTP answer"
msgstr "keine HTTP-Antwort"
