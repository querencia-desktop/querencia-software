#: src/logik.rs:344
msgid ""
"You are not allowed to install or remove software. The request was denied."
msgstr ""
"Non si dispone dell’autorizzazione per installare o rimuovere software. La richiesta è stata rifiutata."

#: src/logik.rs:347
msgid "The session’s authorization dialog (polkit agent) is missing."
msgstr "Manca il dialogo di autorizzazione della sessione (agente polkit)."

#: src/logik.rs:349
#, no-c-format
msgid "The package manager is busy right now ({program})."
msgstr "Il gestore pacchetti è occupato in questo momento ({program})."

#: src/logik.rs:353
msgid "No network connection."
msgstr "Nessuna connessione di rete."

#: src/logik.rs:355
#, no-c-format
msgid "The package “{package}” was not found."
msgstr "Il pacchetto «{package}» non è stato trovato."

#: src/logik.rs:358
#, no-c-format
msgid "Conflicting dependencies: {details}"
msgstr "Dipendenze in conflitto: {details}"

#: src/logik.rs:361
msgid "The package manager (PackageKit) was stopped during the operation."
msgstr ""
"Il gestore pacchetti (PackageKit) è stato arrestato durante l’operazione."

#: src/logik.rs:363
msgid "The operation was cancelled."
msgstr "L’operazione è stata annullata."

#: src/netz.rs:336
msgid "online (PackageKit)"
msgstr "online (PackageKit)"

#: src/netz.rs:337
msgid "online (network available)"
msgstr "online (rete disponibile)"

#: src/netz.rs:339
msgid "online (archive reachable), PackageKit: offline"
msgstr "online (archivio raggiungibile), PackageKit: offline"

#: src/netz.rs:341
msgid "online (archive reachable)"
msgstr "online (archivio raggiungibile)"

#: src/netz.rs:343
#, no-c-format
msgid "offline: {host} not reachable ({reason})"
msgstr "offline: {host} non raggiungibile ({reason})"

#: src/netz.rs:347
msgid "offline: no network and no APT source to check"
msgstr "offline: nessuna rete e nessuna sorgente APT da controllare"

#: src/netz.rs:374
msgid ""
"PackageKit considers the system offline because NetworkManager is installed but does not manage the network."
msgstr ""
"PackageKit considera il sistema offline perché NetworkManager è installato ma non gestisce la rete."

#: src/netz.rs:378
msgid ""
"Remedy: set the netplan renderer to NetworkManager, or remove NetworkManager."
msgstr ""
"Rimedio: impostare il renderer di netplan su NetworkManager oppure rimuovere NetworkManager."

#: src/netz.rs:384 src/netz.rs:497
msgid ""
"PackageKit considers the system offline and may refuse to download packages."
msgstr ""
"PackageKit considera il sistema offline e potrebbe rifiutarsi di scaricare pacchetti."

