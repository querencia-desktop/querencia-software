msgid "All Software"
msgstr "Tous les logiciels"

#: src/logik.rs:26 src/logik.rs:90
msgid "Installed"
msgstr "Installés"

#: src/logik.rs:27
msgid "Updates"
msgstr "Mises à jour"

#: src/logik.rs:28
msgid "Expert List"
msgstr "Liste pour experts"

#: src/logik.rs:88
msgid "Update available"
msgstr "Mise à jour disponible"

#: src/logik.rs:92
msgid "Available"
msgstr "Disponible"

#: src/logik.rs:94
msgid "Not available"
msgstr "Non disponible"

